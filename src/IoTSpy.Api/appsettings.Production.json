{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "IoTSpy": "Information"
    }
  },

  "Database": {
    "Provider": "postgres",
    "ConnectionString": "Host=localhost;Port=5432;Database=iotspy;Username=iotspy;Password=CHANGE_ME"
  },

  "Auth": {
    "JwtSecret": "CHANGE_ME_minimum_32_characters_long_random_secret"
  },

  "Frontend": {
    "Origin": "https://iotspy.example.com"
  },

  "Urls": "https://*:5001;http://*:5000",

  "Kestrel": {
    "Certificate": {
      "Path": "/etc/iotspy/tls.pfx",
      "Password": "CHANGE_ME"
    }
  },

  "RateLimit": {
    "Enabled": true,
    "PermitLimit": 100,
    "WindowSeconds": 60,
    "QueueLimit": 10
  },

  "DataRetention": {
    "Enabled": true,
    "CaptureRetentionDays": 30,
    "PacketRetentionDays": 7,
    "ScanJobRetentionDays": 90,
    "OpenRtbEventRetentionDays": 14,
    "RunIntervalHours": 24
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "IoTSpy": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "/var/log/iotspy/iotspy-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  }
}
